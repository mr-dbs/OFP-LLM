+// DBS: "unit dbsSetBody className" - move a living, on-foot soldier's brain into a new body of another
+// soldier class. Keeps the AIUnit (group slot, leader status, player control, identity, variable name).
+// Weapons are cleared; the calling script re-adds the loadout. Returns the new soldier or objNull.
+// Modelled on NetworkClient::DoRespawn. Written for single player first; the multiplayer branch is best effort.
+GameValue ObjDbsSetBody(const GameState* state, GameValuePar oper1, GameValuePar oper2)
+{
+    Person* body = dyn_cast<Person>(GetObject(oper1));
+    if (!body || !body->IsLocal())
+    {
+        return OBJECT_NULL;
+    }
+    AIUnit* unit = body->Brain();
+    if (!unit || unit->GetLifeState() != AIUnit::LSAlive || unit->GetVehicleIn())
+    {
+        return OBJECT_NULL;
+    }
+
+    GameStringType typeName = oper2;
+    Ref<EntityAI> veh = NewVehicle(typeName);
+    Soldier* soldier = dyn_cast<Soldier>(veh.GetRef());
+    if (!soldier)
+    {
+        return OBJECT_NULL;
+    }
+
+    bool wasPlayer = body == GWorld->PlayerOn();
+    bool wasCamera = GWorld->CameraOn() == body;
+    TargetSide side = body->Vehicle::GetTargetSide();
+    Matrix4 transform = body->Transform();
+
+    // move brain (same order as DoRespawn)
+    soldier->SetBrain(unit);
+    body->SetBrain(nullptr);
+    GWorld->RemoveSensor(body);
+    unit->SetPerson(soldier);
+    unit->SetVehicleIn(nullptr);
+
+    soldier->SetTargetSide(side);
+    AIUnitInfo& info = body->GetInfo();
+    soldier->SetInfo(info);
+    soldier->SetRemotePlayer(body->GetRemotePlayer());
+    soldier->SetFace(info._face, info._name);
+    soldier->SetGlasses(info._glasses);
+
+    RString var = body->GetVarName();
+    if (var.GetLength() > 0)
+    {
+        body->SetVarName(RString());
+        soldier->SetVarName(var);
+        GWorld->GetGameState()->VarSet(var, GameValueExt(soldier), true);
+    }
+
+    soldier->RemoveAllWeapons();
+    soldier->RemoveAllMagazines();
+
+    soldier->SetTransform(transform);
+    soldier->Init(transform);
+    GWorld->AddVehicle(soldier);
+    GWorld->AddSensor(soldier);
+
+    bool net = GWorld->GetMode() == GModeNetware;
+    if (net)
+    {
+        GetNetworkManager().CreateVehicle(soldier, VLTVehicle, var, -1);
+        GetNetworkManager().UpdateObject(soldier);
+        GetNetworkManager().UpdateObject(unit);
+    }
+
+    if (wasPlayer)
+    {
+        if (net)
+        {
+            // NetworkClient::SelectPlayer also performs the local switch for our own player id
+            GetNetworkManager().SelectPlayer(GetNetworkManager().GetPlayer(), soldier, false);
+        }
+        else
+        {
+            GWorld->SwitchCameraTo(soldier, CamInternal);
+            GWorld->SetPlayerManual(true);
+            GWorld->SwitchPlayerTo(soldier);
+            GWorld->SetRealPlayer(soldier);
+            if (GWorld->UI())
+            {
+                GWorld->UI()->ResetVehicle(soldier);
+            }
+        }
+    }
+    else if (wasCamera)
+    {
+        GWorld->SwitchCameraTo(soldier, GWorld->GetCameraType());
+    }
+
+    // old body has no brain now, so DeleteVehicle goes straight to SetDelete
+    DeleteVehicle(body);
+
+    return GameValueExt(soldier);
+}
