	? (eastSelectedGroup == groupAlpha):eastAlphaTeamScript = _order;PublicVariable "eastAlphaTeamScript"
	? (eastSelectedGroup == groupBravo):eastBravoTeamScript = _order;PublicVariable "eastBravoTeamScript"
	? (eastSelectedGroup == groupCharlie):eastCharlieTeamScript = _order;PublicVariable "eastCharlieTeamScript"
	? (eastSelectedGroup == groupDelta):eastDeltaTeamScript = _order;PublicVariable "eastDeltaTeamScript"
	? (eastSelectedGroup == groupEcho):eastEchoTeamScript = _order;PublicVariable "eastEchoTeamScript"
	? (eastSelectedGroup == groupFoxtrot):eastFoxtrotTeamScript = _order;PublicVariable "eastFoxtrotTeamScript"
