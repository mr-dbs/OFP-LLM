;Last modified 12/31/2

_order = _this Select 0
_unit = player
_side = Side _unit

? (_side == east):goto "SetEast"
? (_side != west) && (_side != east):Exit

#SetWest

	;Issue new order to reset previous order.
	? (westSelectedGroup == groupAlpha):westAlphaTeamScript = newOrderScript;PublicVariable "westAlphaTeamScript"
	? (westSelectedGroup == groupBravo):westBravoTeamScript = newOrderScript;PublicVariable "westBravoTeamScript"
	? (westSelectedGroup == groupCharlie):westCharlieTeamScript = newOrderScript;PublicVariable "westCharlieTeamScript"
	? (westSelectedGroup == groupDelta):westDeltaTeamScript = newOrderScript;PublicVariable "westDeltaTeamScript"
	? (westSelectedGroup == groupEcho):westEchoTeamScript = newOrderScript;PublicVariable "westEchoTeamScript"
	? (westSelectedGroup == groupFoxtrot):westFoxtrotTeamScript = newOrderScript;PublicVariable "westFoxtrotTeamScript"
	? (westSelectedGroup == groupGolf):westGolfTeamScript = newOrderScript;PublicVariable "westGolfTeamScript"
	? (westSelectedGroup == groupHotel):westHotelTeamScript = newOrderScript;PublicVariable "westHotelTeamScript"
	? (westSelectedAll):westAlphaTeamScript = newOrderScript;PublicVariable "westAlphaTeamScript";westBravoTeamScript = newOrderScript;PublicVariable "westBravoTeamScript";westCharlieTeamScript = newOrderScript;PublicVariable "westCharlieTeamScript";westDeltaTeamScript = newOrderScript;PublicVariable "westDeltaTeamScript";westEchoTeamScript = newOrderScript;PublicVariable "westEchoTeamScript";westFoxtrotTeamScript = newOrderScript;PublicVariable "westFoxtrotTeamScript";westGolfTeamScript = newOrderScript;PublicVariable "westGolfTeamScript";westHotelTeamScript = newOrderScript;PublicVariable "westHotelTeamScript"

	~1

	;Now issue the order that was passed to this script.
	? (westSelectedGroup == groupAlpha):westAlphaTeamScript = _order;PublicVariable "westAlphaTeamScript"
	? (westSelectedGroup == groupBravo):westBravoTeamScript = _order;PublicVariable "westBravoTeamScript"
	? (westSelectedGroup == groupCharlie):westCharlieTeamScript = _order;PublicVariable "westCharlieTeamScript"
	? (westSelectedGroup == groupDelta):westDeltaTeamScript = _order;PublicVariable "westDeltaTeamScript"
	? (westSelectedGroup == groupEcho):westEchoTeamScript = _order;PublicVariable "westEchoTeamScript"
	? (westSelectedGroup == groupFoxtrot):westFoxtrotTeamScript = _order;PublicVariable "westFoxtrotTeamScript"
	? (westSelectedGroup == groupGolf):westGolfTeamScript = _order;PublicVariable "westGolfTeamScript"
	? (westSelectedGroup == groupHotel):westHotelTeamScript = _order;PublicVariable "westHotelTeamScript"
	? (westSelectedAll):westAlphaTeamScript = _order;PublicVariable "westAlphaTeamScript";westBravoTeamScript = _order;PublicVariable "westBravoTeamScript";westCharlieTeamScript = _order;PublicVariable "westCharlieTeamScript";westDeltaTeamScript = _order;PublicVariable "westDeltaTeamScript";westEchoTeamScript = _order;PublicVariable "westEchoTeamScript";westFoxtrotTeamScript = _order;PublicVariable "westFoxtrotTeamScript";westGolfTeamScript = _order;PublicVariable "westGolfTeamScript";westHotelTeamScript = _order;PublicVariable "westHotelTeamScript"

	Exit

