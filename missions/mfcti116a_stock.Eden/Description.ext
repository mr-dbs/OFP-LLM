//Coop version.
#include "mfcti1.16\MortarMenu.h"

respawn = 3;
respawndelay = 30;
onLoadMission = $STRMODNAME;

//Various game properties.
/*
West Coop							- West player side works againt the east AI side.
East Coop							- East player side works againt the west AI side.
More income							- Income received for towns is increased.  This is applied to both sides.
No AC Rockets						- Aircraft have no FFARs.

Opposition							- Default is Light.  Higher values increase amount of resistance spawned and starting AI side's resources.
Defend the Base						- The AI side will make an all out assault on the player's base.  They start closer and know the base's location.

If you wish to pass parameters in from a .cfg simply add the values for combined choices.
Example: west coop & more income - 1 + 4 = 5 (param1 = 5).
Example: east coop, defend the base, heavy opposition - 2, 2 (param1 = 1, param2 = 2).
*/

#define WESTCOOP				1
#define EASTCOOP				2
#define LESSUNITS				4
#define NIGHT					8

#define LIGHTOP					1
#define AVERAGEOP				2
#define HEAVYOP					4
#define INSANEOP				8
#define DTB						16

titleParam1 = $STRPARAM1LABEL;
valuesParam1[] = {WESTCOOP,EASTCOOP,WESTCOOP+LESSUNITS,EASTCOOP+LESSUNITS,NIGHT+WESTCOOP,NIGHT+EASTCOOP,NIGHT+LESSUNITS+WESTCOOP,NIGHT+LESSUNITS+EASTCOOP};
defValueParam1 = WESTCOOP;
textsParam1[] = {$STRPARAMCOOP1A,$STRPARAMCOOP1B,$STRPARAMCOOP1C,$STRPARAMCOOP1D,$STRPARAMCOOP1E,$STRPARAMCOOP1F,$STRPARAMCOOP1G,$STRPARAMCOOP1H};

titleParam2 = $STRPARAMCOOP2LABEL;
valuesParam2[] = {LIGHTOP,AVERAGEOP,HEAVYOP,INSANEOP,DTB,AVERAGEOP+DTB,HEAVYOP+DTB,INSANEOP+DTB};
defValueParam2 = INSANEOP;
textsParam2[] = {$STRPARAMCOOP2A,$STRPARAMCOOP2B,$STRPARAMCOOP2C,$STRPARAMCOOP2D,$STRPARAMCOOP2E,$STRPARAMCOOP2F,$STRPARAMCOOP2G,$STRPARAMCOOP2H};

