;Last modified 2/19/4
private ["_currentGroup","_role"]
_currentGroup = ObjNull
_role = 0

_unit = _this Select 0

@ (serverStarted)

_weapon = "AK74"
_magazine = "AK74"
_secondary = "RPGLauncher"
_secondaryMagazine = "RPGLauncher"

? (!publicServer && scopedWeapons):_weapon = "MFCTI116AK101";_magazine = "MFCTI116AK101Mag"

? (Side _unit != east):Exit
? (Group _unit In eastPlayerGroups):goto "EquipStandard"

_count = 0
_totalTeams = Count teamDesignations

#GetTeamRole

	Call Format["_currentGroup = east%1Team",teamMapDesignations Select _count]
	? (_currentGroup == Group _unit):Call Format["_role = east%1Role",teamMapDesignations Select _count]

	_count = _count + 1
	? (_count < _totalTeams):goto "GetTeamRole"

;If team is an independent AI then equip according to role.
? (_role == blackOpsRole):_weapon = "Bizon";_magazine = "BizonMag"
? (_role == infantryAARole):_secondary = "9K32Launcher";_secondaryMagazine = "9K32Launcher"
? (_role == infantryATRole):_secondary = "AT4Launcher";_secondaryMagazine = "AT4Launcher"

#EquipStandard

RemoveAllWeapons _unit 

_unit AddMagazine _magazine
_unit AddMagazine _magazine
_unit AddMagazine _magazine
_unit AddMagazine _magazine

? (_role == infantryAARole || _role == infantryATRole):goto "Equip"

_unit AddMagazine _magazine
_unit AddMagazine _magazine

#Equip

_unit AddWeapon _weapon
_unit selectWeapon _weapon

_unit AddMagazine _secondaryMagazine
_unit AddWeapon _secondary

? (_role == infantryAARole || _role == infantryATRole):goto "EquipMisc"

_unit AddMagazine "HandGrenade"
_unit AddMagazine "HandGrenade"

#EquipMisc

_unit AddWeapon "Binocular"

? (acceleratedTime || nightMission):_unit AddWeapon "NVGoggles"
