	_closestDistance = 10000
	_tempTargets = []
	_tempTargetDistances = []
	_closestTarget = ObjNull

	;BUILD A LIST OF TAKEN TOWNS
	_count = 0
	_maxTargets = Count towns

	? (_maxTargets < 1):goto "Update"

	;Add any friendly towns to the defend target list.
	#CheckTowns

	;If a town is taken then add it to the list.
	? (_side == west):_tempSide = "west"
	? (_side == east):_tempSide = "east"

	? (townSides Select _count == _tempSide):_tempTargets = _tempTargets + [towns Select _count];_tempTargetDistances = _tempTargetDistances + [Leader _group Distance (towns Select _count)]

	_count = _count + 1

	? (_count < _maxTargets):goto "CheckTowns"

	;DETERMINE WHICH TOWN IS CLOSEST
	_count = 0
	_maxTargets = Count _tempTargets

	;If no friendly towns have been found then check for any targets.
	? (_maxTargets < 1):goto "FindClosestBase"

	;Check for a closer target.
	#CheckClosestTowns

		? (_tempTargetDistances Select _count < _closestDistance):_closestDistance = _tempTargetDistances Select _count;_closestTarget = _tempTargets Select _count

		_count =_count + 1

		? (_count < _maxTargets):goto "CheckClosestTowns"

	? (_side == west):_totalBases = Count westControlCenter
	? (_side == east):_totalBases = Count eastControlCenter

	;If no bases exist then skip closest base check.
	? (_totalBases < 1):goto "MoveToClosestDefendTarget"

	_count = 0

	;Find base closest to group leader.
	#FindClosestBase

		? (_side == west):_base = westControlCenter Select _count
		? (_side == east):_base = eastControlCenter Select _count

		_count =_count + 1
		_distance = Leader _group Distance _base

		? (_distance < _closestDistance):_closestDistance = _distance;_closestTarget = _base
		? (_count < _totalBases):goto "FindClosestBase"

	#MoveToClosestDefendTarget

		? (IsNull _closestTarget) && (_side == west):westMessage = messageOrderDefendDenied;PublicVariable "westMessage";westPlayerMessageGroupFrom = _groupValue;PublicVariable "westPlayerMessageGroupFrom"
		? (IsNull _closestTarget) && (_side == east):eastMessage = messageOrderDefendDenied;PublicVariable "eastMessage";eastPlayerMessageGroupFrom = _groupValue;PublicVariable "eastPlayerMessageGroupFrom"

		? (Leader _group Distance _closestTarget < targetDefendRange):goto "DefendTarget"
	
		_destinationObject SetPos GetPos _closestTarget
		? (_role != airRole):_group Move GetPos _destinationObject

		goto "Update"

#DefendTarget

	_defendingTarget = true
	_unmannedGuns = []

	#FindUnmannedMortar

		? (_side == west):_gunList = westMortar
		? (_side == east):_gunList = eastMortar

		_return = "FindUnmannedAAStations";goto "FindUnmannedGuns"

	#FindUnmannedAAStations

		? (_side == west):_gunList = westAAStation
		? (_side == east):_gunList = eastAAStation

		_return = "FindUnmannedAAGuns";goto "FindUnmannedGuns"

	#FindUnmannedAAGuns

		? (_side == west):_gunList = westAAGun
		? (_side == east):_gunList = eastAAGun

		_return = "FindUnmannedHEFortifications";goto "FindUnmannedGuns"

	#FindUnmannedHEFortifications

		? (_side == west):_gunList = westHEFortification
		? (_side == east):_gunList = eastHEFortification

		_return = "FindUnmannedHEStations";goto "FindUnmannedGuns"

	#FindUnmannedHEStations

		? (_side == west):_gunList = westHEStation
		? (_side == east):_gunList = eastHEStation

		_return = "FindUnmannedHEGuns";goto "FindUnmannedGuns"

	#FindUnmannedHEGuns

		? (_side == west):_gunList = westHEGun
		? (_side == east):_gunList = eastHEGun

		_return = "FindUnmannedM2Fortifications";goto "FindUnmannedGuns"

	#FindUnmannedM2Fortifications

		? (_side == west):_gunList = westM2Fortification
		? (_side == east):_gunList = eastM2Fortification

		_return = "FindUnmannedM2Stations";goto "FindUnmannedGuns"

	#FindUnmannedM2Stations

		? (_side == west):_gunList = westM2Station
		? (_side == east):_gunList = eastM2Station

		_return = "FindUnmannedM2Guns";goto "FindUnmannedGuns"

	#FindUnmannedM2Guns

		? (_side == west):_gunList = westM2Gun
		? (_side == east):_gunList = eastM2Gun

		_return = "AssignToGuns";goto "FindUnmannedGuns"

	#AssignToGuns

		? (Count _unmannedGuns < 1):_units = Units _group;goto "StartDefendTargetPatrol"

		_units = Units _group
		_units = _units - [Leader _group]
		_units = _units + [Leader _group]

		#AssignToGun

			? (Count _unmannedGuns < 1) && (Count _units > 0):goto "StartDefendTargetPatrol"
			? (Count _units < 1):goto "Update"

			_gunner = _units Select 0
			_gun = _unmannedGuns Select 0
			_units = _units - [_gunner]

			;If potential gunner is not in a vehicle then assign to current gun.
			? (Vehicle _gunner == _gunner):_gunner AssignAsGunner _gun;[_gunner] OrderGetIn true;_unmannedGuns = _unmannedGuns - [_gun]

			goto "AssignToGun"

		#StartDefendTargetPatrol

			_count = 0
			_totalUnits = Count _units

		;Patrol the target if not manning a stationary gun.
		#DefendTargetPatrol

			_unit = _units Select _count
			_count = _count + 1

			? !(CanMove Vehicle _unit) || (GetDammage _unit >= 1):goto "DefendTargetPatrolNext"

			;Change direction.
			_direction = Random 359
			_position = GetPos _closestTarget
			_distance = (targetDefendRange / 3) + Random (targetDefendRange - (targetDefendRange / 3))
			_destination = [(_position Select 0)+((Sin _direction)*_distance),(_position Select 1)+((Cos _direction)*_distance),_position Select 2]

			;Occasionally return to target.
			? (Random 100 < 25):_destination = _position

			_destinationObject SetPos _destination

			? (_role != airRole):_unit DoMove _destination

			#DefendTargetPatrolNext

				? (_count < _totalUnits):goto "DefendTargetPatrol"

		goto "Update"

#FindUnmannedGuns

	_count = 0
	_totalGuns = Count _gunList

	? (_totalGuns < 1):goto _return

	#CheckForUnmannedGun

		_gun = _gunList Select _count
		? (IsNull _gun):goto "CheckNextUnmannedGun"

		_distance = Leader _group Distance _gun
		_count =_count + 1

		? ((IsNull Gunner _gun)||(!Alive Gunner _gun))&&(_distance < targetDefendRange):_unmannedGuns = _unmannedGuns + [_gun]

		#CheckNextUnmannedGun

			? (_count < _totalGuns):goto "CheckForUnmannedGun"

		goto _return





#TakeTownsAndBases

	? !(Alive Leader _group):goto "Update"
	? (_reportMission) && (_side == west):westMessage = messageOrderTakeTowns;PublicVariable "westMessage";westPlayerMessageGroupFrom = _groupValue;PublicVariable "westPlayerMessageGroupFrom";_reportMission = false
	? (_reportMission) && (_side == east):eastMessage = messageOrderTakeTowns;PublicVariable "eastMessage";eastPlayerMessageGroupFrom = _groupValue;PublicVariable "eastPlayerMessageGroupFrom";_reportMission = false

	_tempTargets = []
	_tempTargetDistances = []

	;BUILD A LIST OF UNTAKEN TOWNS
	_count = 0
	_maxTargets = Count towns

	;If no town targets then check for base targets.
	? (_maxTargets < 1):goto "CheckBaseTargets"
	? (defendTheBase) && (_scriptType == takeTownsAndBasesScript):goto "CheckBaseTargets"

	#CheckTownTarget

		;If a town is untaken then add it to the list.
		? (_side == west):_tempSide = "west"
		? (_side == east):_tempSide = "east"

		? (townSides Select _count != _tempSide):_tempTargets = _tempTargets + [towns Select _count];_tempTargetDistances = _tempTargetDistances + [Leader _group Distance (towns Select _count)]

		_count = _count + 1

		? (_count < _maxTargets):goto "CheckTownTarget"

	;If this is not an AI controlled side or a public server then don't target the base.
	? (publicServer):goto "FindClosestTownsBases"

	;BUILD A LIST OF UNDESTROYED ENEMY STRUCTURES
	#CheckBaseTargets

	? (_side == west):_structureList = eastControlCenter + eastInfantryFactory + eastLightFactory + eastHeavyFactory + eastAirFactory + [EastMobileHQ]
	? (_side == east):_structureList = westControlCenter + westInfantryFactory + westLightFactory + westHeavyFactory + westAirFactory + [WestMobileHQ]

	_count = 0
	_maxStructureTargets = Count _structureList

	;If no base or towns were found then return.
	? (_maxTargets < 1) && (_maxStructureTargets < 1):goto "Update"
	? (_maxStructureTargets < 1):goto "FindClosestTownsBases"

	#CheckBaseTarget

		_structure = _structureList Select _count
		_count = _count + 1

		? (GetDammage _structure < 1):_tempTargets = _tempTargets + [_structure];_tempTargetDistances = _tempTargetDistances + [Leader _group Distance _structure]
		? (_count < _maxStructureTargets):goto "CheckBaseTarget"

	;DETERMINE WHICH TARGET IS CLOSEST
	#FindClosestTownsBases

	_count = 0
	_closestDistance = 10000
	_closestTarget = ObjNull
	_maxTargets = Count _tempTargets

	? (_maxTargets < 1):goto "Update"

	;Check for a closer target.
	#FindClosestTownBase

		_attackUnits = Units _group
		_attackUnits = _attackUnits - [Leader _group]
		_tempTarget = _tempTargets Select _count

		;Attack the MHQ even if it is empty.
		? (_tempTarget == EastMobileHQ) && (_tempTargetDistances Select _count < 60):Leader _group DoTarget _tempTarget;Leader _group DoFire _tempTarget;[_attackUnits] CommandTarget _tempTarget;[_attackUnits] CommandFire _tempTarget;_closestTarget = _tempTarget;goto "ForceMHQAttack"
		? (_tempTarget == WestMobileHQ) && (_tempTargetDistances Select _count < 60):Leader _group DoTarget _tempTarget;Leader _group DoFire _tempTarget;[_attackUnits] CommandTarget _tempTarget;[_attackUnits] CommandFire _tempTarget;_closestTarget = _tempTarget;goto "ForceMHQAttack"

		;If within range of the enemy base move to the next target.
		? (_scriptType == takeTownsAndBasesScripts) && ((_tempTargets Select _count) In _structureList) && (_tempTargetDistances Select _count < _closestDistance)&&(_tempTargetDistances Select _count < 75):goto "FindNextClosestTownBase"
		? (_tempTargetDistances Select _count < _closestDistance)&&(_tempTargetDistances Select _count > 25):_closestDistance = _tempTargetDistances Select _count;_closestTarget = _tempTargets Select _count

		#FindNextClosestTownBase

		_count = _count + 1

		? (_count < _maxTargets):goto "FindClosestTownBase"

	? (IsNull _closestTarget):goto "Update"

	_direction = Random 360
	_position = GetPos _closestTarget
	_destinationObject SetPos [(_position Select 0)+((sin _direction)*15),(_position Select 1)+((cos _direction)*15),_position Select 2]
	? (_role != airRole):_group Move GetPos _destinationObject
	goto "Update"

#SearchAndDestroy

	? (_reportMission) && (_side == west):westMessage = messageOrderSearchAndDestroy;PublicVariable "westMessage";westPlayerMessageGroupFrom = _groupValue;PublicVariable "westPlayerMessageGroupFrom";_reportMission = false
	? (_reportMission) && (_side == east):eastMessage = messageOrderSearchAndDestroy;PublicVariable "eastMessage";eastPlayerMessageGroupFrom = _groupValue;PublicVariable "eastPlayerMessageGroupFrom";_reportMission = false

	_town = towns Select (Random (_totalTowns - 1))
	_position = GetPos _town

	? (_side == west) && !(IsNull westBaseFound) && (GetDammage westBaseFound < 1):_position = GetPos westBaseFound
	? (_side == east) && !(IsNull eastBaseFound) && (GetDammage eastBaseFound < 1):_position = GetPos eastBaseFound

	? (_baseFound):_x = (_position Select 0) + (Random 200) - 100;_y = (_position Select 1) + (Random 200) - 100;goto "MoveToSearchAndDestroyTarget"

	_leaderPosition = GetPos Leader _group
	_x = (_position Select 0) + (((_leaderPosition Select 0) - (_position Select 0)) / 2) * (Random 1)
	_y = (_position Select 1) + (((_leaderPosition Select 1) - (_position Select 1)) / 2) * (Random 1)

#MoveToSearchAndDestroyTarget

	_destinationObject SetPos [_x,_y,0]
	? (_role != airRole):_group Move [_x,_y]

	_count = 0
	_units = Units _group
	_totalUnits = Count _units
	_saboteurs = []

	? (_totalUnits < 1):goto "Update"

	#CountSaboteur

		_saboteur = _units Select _count
		_count = _count + 1

		? (Alive _saboteur) && (_saboteur Ammo "Timebomb" > 0) && (Vehicle _saboteur == _saboteur):_saboteurs = _saboteurs + [_saboteur]
		? (_count < _totalUnits):goto "CountSaboteur"

	? (Count _saboteurs > 0):goto "SaboteurCheck"
	goto "Update"

;Check to see if current saboteur knows the location of the enemy mobile HQ.
#SaboteurCheck

	? (_side == west):_targets = [EastMobileHQ] + eastControlCenter + eastInfantryFactory + eastLightFactory + eastHeavyFactory + eastAirFactory;_spottedTargets = westSpottedUnits - [EastMobileHQ]
	? (_side == east):_targets = [WestMobileHQ] + westControlCenter + westInfantryFactory + westLightFactory + westHeavyFactory + westAirFactory;_spottedTargets = eastSpottedUnits - [WestMobileHQ]

	_saboteurCount = 0
	_totalSaboteurs = Count _saboteurs
	_totalTargets = Count _targets

	#UpdateSaboteur

		_count = 0
		_checkedTargets = []
		_count = Random (_totalTargets - 1)
		_saboteur = _saboteurs Select _saboteurCount

	#FindSaboteurTarget

		_target = _targets Select _count
		? (Count _saboteurTargets > _saboteurCount):_target = _saboteurTargets Select _saboteurCount

		_distance = _target Distance _saboteur
		_checkedTargets  = _checkedTargets + [_count]

		? (_distance < 300) && (GetDammage _target < 1) && ((_saboteur KnowsAbout _target >= 1) || (_target In _spottedTargets)):goto "SabotageTarget"
		_saboteurTargets = _saboteurTargets - [_target]

		#GetRandomTarget

			_count = Random (_totalTargets - 1)
			? (_count In _checkedTargets):goto "GetRandomTarget"

		? (Count _checkedTargets < _totalTargets):goto "FindSaboteurTarget"

	#UpdateNextSaboteur

		_saboteurCount = _saboteurCount + 1
		? (_saboteurCount < _totalSaboteurs):goto "UpdateSaboteur"

	goto "Update"

#SabotageTarget

	? !(_target In _saboteurTargets):_saboteurTargets = _saboteurTargets + [_target]
	_saboteur CommandMove GetPos _target

	#SaboteurCheckDistance

		? (_distance < 15):goto "SaboteurDropBomb"

	goto "UpdateNextSaboteur"

;Make the saboteur drop a satchel by the enemy's structure.
#SaboteurDropBomb

	_saboteur Fire ["throw","Timebomb","Timebomb"]
	~2

	;Pick a random direction and run like hell from the bomb.
	_direction = Random 359
	_position = GetPos _saboteur
	_saboteur CommandMove [(_position Select 0)+((sin _direction)*50),(_position Select 1)+((cos _direction)*50),_position Select 2]
	goto "UpdateNextSaboteur"

#ForceMHQAttack

	_count = 0
	_units = Units _group
	_teamSize = Count _units
	_vehicles = []

	#GetVehicleInRange

		_vehicle = Vehicle (_units Select _count)

		? (_vehicle In _vehicles) || (_vehicle Distance _closestTarget > 50) || (_vehicle In westAirVehicles) || (_vehicle In eastAirVehicles):goto "GetNextVehicleInRange"

		_vehicles = _vehicles + [_vehicle]
		_vehicle DoWatch _closestTarget

		#GetNextVehicleInRange

			_count = _count  + 1
			? (_count < _teamSize):goto "GetVehicleInRange"

	_totalVehicles = Count _vehicles
	? (_totalVehicles < 1):goto "Update"

	~2
	_count = 0

	;Determine weapon type of each vehicle and fire a shell at the MHQ.
	#FireVehicle

		_vehicle = _vehicles Select _count
		_weapons = Weapons _vehicle

		_totalWeapons = Count _weapons
		? (_totalWeapons < 1):goto "FireNextVehicle"

		_weaponCount = 0

		#CheckWeapon

			_weapon = _weapons Select _weaponCount
			? (_weapon In AIMainWeapons):_vehicle Fire _weapon;goto "FireNextVehicle"

			_weaponCount = _weaponCount + 1
			? (_weaponCount < _totalWeapons):goto "CheckWeapon"

		#FireNextVehicle

			_count = _count + 1
			? (_count < _totalVehicles):goto "FireVehicle"

		goto "Update"

#WaitForRespawn

	_deadUnit = Leader _group
	_deathLocation = GetPos Leader _group

	@ (Alive Leader _group)

	[_deadUnit] Exec "Main\RespawnableUnitCleanUp.sqs"
	[Leader _group,_deathLocation] Exec "Main\RespawnUnit.sqs"

	goto "Update"
