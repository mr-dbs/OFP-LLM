					? (_infantryCount < _totalUnits):goto "UpdateInfantryMember"

			goto "UpdateInfantryGoal"

#UpdateInfantryGoal

	_updateFormationReturn = "UpdateGoal";goto "UpdateFormation"

#UpdateFormation

	;If anyone was out of formation previously order those now in range to follow.
	? (_checkFormation):_checkFormation = false;_units = _units - [_unitsOutOfFormation];[_units] CommandFollow Leader _group

	;If anyone is out of formation keep track of it for next update.
	? (_outOfFormation):_outOfFormation = false;_checkFormation = true

	goto _updateFormationReturn

#UpdateGoal

	? (_side == west):_defenseTeams = westDefenseTeams;_defendedTargets = westDefendedTargets
	? (_side == east):_defenseTeams = eastDefenseTeams;_defendedTargets = eastDefendedTargets

	;LLM link (added): a team smaller than the stock minimum whose leader is on foot does not set out. Stock sent
	;a lone leader towards the nearest town on the first pass after every new order. A crew still in its vehicle
	;carries on as before, and an explicit move order is still obeyed.
	? (_llm) && (_role != airRole) && (Count Units _group < minIndependentSize) && (Leader _group == Vehicle Leader _group) && (_scriptType != moveToWaypointScript):goto "Update"

	? (_scriptType == moveToWaypointScript) && (_newOrder):goto "MoveToWaypoint"
	? (_scriptType == assaultScript) || (_scriptType == takeTownsAndBasesScript):goto "TakeTownsAndBases"
	? (_scriptType == defenseScript) || (_scriptType == defendBaseScript):goto "DefendTowns"
	? (_scriptType == defendTownsAndBasesScript):goto "CheckDefendTargets"
	? (_scriptType == searchAndDestroyScript):goto "SearchAndDestroy"

	goto "Update"
#MoveToWaypoint

	? (_side == west):_waypointMarker = "WestCommanderWP";_WPDestination = westCommanderWPDestination
	? (_side == east):_waypointMarker = "EastCommanderWP";_WPDestination = eastCommanderWPDestination

	_destinationObject SetPos GetPos _WPDestination

	;LLM link (added): each team has its own destination when the LLM commands this side.
	? (_side == west) && (llmWestControl):_destinationObject SetPos (llmWestDest Select _groupValue)
	? (_side == east) && (llmEastControl):_destinationObject SetPos (llmEastDest Select _groupValue)

	? (_reportMission) && (_side == west):westMessage = messageOrderMoveToWaypoint;PublicVariable "westMessage";westPlayerMessageGroupFrom = _groupValue;PublicVariable "westPlayerMessageGroupFrom";_reportMission = false
	? (_reportMission) && (_side == east):eastMessage = messageOrderMoveToWaypoint;PublicVariable "eastMessage";eastPlayerMessageGroupFrom = _groupValue;PublicVariable "eastPlayerMessageGroupFrom";_reportMission = false
	? (_role != airRole):_group Move GetPos _destinationObject

	_newOrder = false
	goto "Update"

;Return to position in front of barracks.
#ReturnToBarracks

	_getFactoryPositionReturn = "SetBaseDestination";goto "GetBarracksPosition"

;Return to position in front of factory.
#ReturnToFactory

	;LLM link (added): a leader already in a working vehicle beside the factory is close enough to buy (the purchase
	;range is larger than this). He is not ordered to shuffle his vehicle to the door among the ones parked there.
	? (_llm) && (Leader _group != Vehicle Leader _group) && (CanMove Vehicle Leader _group) && !(IsNull Driver Vehicle Leader _group) && (Leader _group Distance _nearestFactory < 60):goto "Update"

	_getFactoryPositionReturn = "SetBaseDestination";goto "GetFactoryPosition"

#SetBaseDestination

	_group Move _destination

	;LLM link (added): under LLM control the leader is not also sent by name. An order by name takes him out of
	;the main body of his team until he has carried it out, and the engine gives a group order (Move) to the main
	;body only. A leader put into the driving seat of a new vehicle while he still holds such an order never
	;finishes it: in the trial of 8 October every team that froze at base had its leader in exactly that state.
	_byName = true
	? (_llm):_byName = false
	? (_byName):Leader _group DoMove _destination

	? !(CanMove (Vehicle Leader _group)) || (IsNull Driver (Vehicle Leader _group)):UnassignVehicle Leader _group

	goto "Update"

;Get position in front of barracks.
#GetBarracksPosition

	_direction = ((GetDir _nearestFactory + 90) + (Random 5) - 10) % 360
	goto "GetBuildingPosition"

;Get position in front of factory.
#GetFactoryPosition

	_direction = ((GetDir _nearestFactory + 180) + (Random 5) - 10) % 360

;Get slightly random position in front of building.
#GetBuildingPosition

	_position = GetPos _nearestFactory

	_distance = (Random 10) + 12
	_destination = [(_position Select 0)+((sin _direction)*_distance),(_position Select 1)+((cos _direction)*_distance),_position Select 2]
	_destinationObject SetPos _destination

	goto _getFactoryPositionReturn

;Finds the nearest qualifying factory.
#GetNearestFactory

	_nearestDistance = 100000
	_nearestFactory = ObjNull
	_getFactoryListReturn = "FindFactories"

	? (_side == west):goto "GetWestFactoryList"
	? (_side == east):goto "GetEastFactoryList"

	goto _getNearestFactoryReturn

	#FindFactories

		_nearestCount = 0
		_totalFactories = Count _factoryList

		? (_totalFactories < 1):goto _getNearestFactoryReturn

		#FindFactory

			_factory = _factoryList Select _nearestCount
			_distance = Leader _group Distance _factory 
			_nearestCount = _nearestCount + 1

			? (_distance < _nearestDistance) && (GetDammage _factory < 1):_nearestDistance = _distance;_nearestFactory = _factory

			? (_nearestCount < _totalFactories):goto "FindFactory"

	goto _getNearestFactoryReturn

#GetWestFactoryList

	? (_factoryType == infantryFactoryType):_factoryList = westInfantryFactory
	? (_factoryType == lightFactoryType):_factoryList = westLightFactory
	? (_factoryType == heavyFactoryType):_factoryList = westHeavyFactory
	? (_factoryType == airFactoryType):_factoryList = westAirFactory

	goto _getFactoryListReturn

#GetEastFactoryList

	? (_factoryType == infantryFactoryType):_factoryList = eastInfantryFactory
	? (_factoryType == lightFactoryType):_factoryList = eastLightFactory
	? (_factoryType == heavyFactoryType):_factoryList = eastHeavyFactory
	? (_factoryType == airFactoryType):_factoryList = eastAirFactory

	goto _getFactoryListReturn

;Gets vehicles for team.
#GetTeamVehicles

	_teamVehicleCount = 0
	_totalTransportPositions = 0
	_teamVehicles = []
	_units = Units _group
	_totalUnits = Count _units

	? (_totalUnits < 1):goto _returnGetTeamVehicles

	#GetTeamVehicle

		_unit = _units Select _teamVehicleCount
		_vehicle = Vehicle (_units Select _teamVehicleCount)
		_teamVehicleCount = _teamVehicleCount + 1

		? (_unit == _vehicle) || !(CanMove _vehicle) || (_vehicle In _teamVehicles):goto "GetNextTeamVehicle"
		
		_teamVehicles = _teamVehicles + [_vehicle]

		;If _inRangeDistance is positive then only add unit to array if in range of _currentUnit.
		? (_inRangeDistance > 0) && (_currentUnit Distance _vehicle > _inRangeDistance):_teamVehicles = _teamVehicles - [_vehicle];goto "GetNextTeamVehicle"

		;If only transports are wanted then check for available transport spaces now.
		? (_transportOnly):_transport = _vehicle;_transportPositionReturn = "GetTeamTransport";goto "GetAvailableTransportPositions"

		#GetTeamTransport

			;If only transports are wanted and no transport space exists remove this vehicle from list.
			? (_transportOnly) && (_availableTransportPositions < 1):_teamVehicles = _teamVehicles - [_vehicle]
			? (_transportOnly):_totalTransportPositions = _totalTransportPositions + _availableTransportPositions

		#GetNextTeamVehicle

			? (_teamVehicleCount < _totalUnits):goto "GetTeamVehicle"

		goto _returnGetTeamVehicles

#EmbarkAsDriverInTeamVehicle

;	_vehicle = _teamVehicles Select (Random (Count _teamVehicles))
	_vehicle = _teamVehicles Select 0

	UnassignVehicle Driver _vehicle
	;_currentUnit DoMove GetPos _vehicle
	_currentUnit AssignAsDriver _vehicle
	;[_currentUnit] OrderGetIn true

	goto _embarkAsDriverInTeamVehicleReturn

;Get free positions on transport.
#GetAvailableTransportPositions

	_totalTransportPositions = 0;_transportReturn = "CountTransportPositions";goto "GetTotalTransportPositions"

	#CountTransportPositions

		_transportCrew = Crew _transport
		_transportCrew = _transportCrew - [Driver _transport];_transportCrew = _transportCrew - [Commander _transport];_transportCrew = _transportCrew - [Gunner _transport]

		_transportCrewBoarded = Count _transportCrew
		_availableTransportPositions = _totalTransportPositions - _transportCrewBoarded

		goto _transportPositionReturn

;Get max positions available for a given transport
#GetTotalTransportPositions

	_transportPositionsCount = 0
	_transportNames = westTransportNames + eastTransportNames
	_transportPositions = westTransportPositions + eastTransportPositions
	_totalTransports = Count _transportNames

	#FindMatchingTransport

		;CountType doesn't seem to return Vulcans or sometimes BMPs.
		;BMPs are returned when BMP2s are counted.
		_transportName = _transportNames Select _transportPositionsCount
		_transportsFound = (_transportName CountType [_transport])
		_BMP2Found = 0
		_M2A2Found = 0

		;Some vehicles such as BMP2s will return from a CountType as a BMP.  Do a special check for these.
		? (_transportName == "BMP"):_BMP2Found = ("BMP2" CountType [_transport])
		? (_transportName == "M113"):_M2A2Found = ("bradley" CountType [_transport])

		? (_BMP2Found > 0):_totalTransportPositions = _transportPositions Select (_transportPositionsCount + 1);goto _transportReturn
		? (_M2A2Found > 0):_totalTransportPositions = _transportPositions Select (_transportPositionsCount + 2);goto _transportReturn
		? (_transportsFound > 0):_totalTransportPositions = _transportPositions Select _transportPositionsCount;goto _transportReturn

		_transportPositionsCount = _transportPositionsCount + 1

		? (_transportPositionsCount < _totalTransports):goto "FindMatchingTransport"

	goto _transportReturn

;Check if AI teams need to defend a target or just take towns.
#CheckDefendTargets

	_totalGroups = Count _defenseTeams
	? !(_group In _defenseTeams) || (_totalGroups < 1):goto "TakeTownsAndBases"

	_count = 0

	#FindDefenseTeam

		_defender = _defenseTeams Select _count
		? (_defender == _group):goto "SetDefenseTeam"

		_count = _count + 1
		? (_count < _totalGroups):goto "FindDefenseTeam"

	goto "TakeTownsAndBases"

	#SetDefenseTeam

		? ((Count _defendedTargets) <= _count):goto "TakeTownsAndBases"
		_closestTarget = _defendedTargets Select _count

;AI routines for defending towns.
#DefendTowns

	_goalLoopCount = _goalLoopCount + 1

	? (_goalLoopCount < 3) && !(_reportMission):goto "Update"
	
	_goalLoopCount = 0

	? !(Alive Leader _group):goto "Update"
	? (_reportMission) && (_side == west):westMessage = messageOrderDefend;PublicVariable "westMessage";westPlayerMessageGroupFrom = _groupValue;PublicVariable "westPlayerMessageGroupFrom";_reportMission = false;_closestTarget = ObjNull
	? (_reportMission) && (_side == east):eastMessage = messageOrderDefend;PublicVariable "eastMessage";eastPlayerMessageGroupFrom = _groupValue;PublicVariable "eastPlayerMessageGroupFrom";_reportMission = false;_closestTarget = ObjNull

	;If a town was previously chosen and in range then do a patrol.
	? !(IsNull _closestTarget):goto "MoveToClosestDefendTarget"

