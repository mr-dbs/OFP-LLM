_count = 0
_totalTemplates = Count westTemplateNames

#CalculateWestTemplateCosts

	_cost = (westPrimaryCosts Select (westTemplatePrimary Select _count)) + (westSecondaryCosts Select (westTemplateSecondary Select _count)) + (westSidearmCosts Select (westTemplateSidearms Select _count))
	_cost = _cost + ((westPrimaryAmmoCosts Select (westTemplatePrimary Select _count)) * (westTemplatePrimaryAmmo Select _count))
	_cost = _cost + ((westSecondaryAmmoCosts Select (westTemplateSecondary Select _count)) * (westTemplateSecondaryAmmo Select _count))
	_cost = _cost + (((miscCosts Select (westTemplateMisc Select _count)) * (westTemplateAmount Select _count)) + ((miscCosts Select (westTemplateMisc1 Select _count)) * (westTemplateAmount1 Select _count)))

	westTemplateCosts = westTemplateCosts + [_cost]
	_count = _count + 1
	? (_count < _totalTemplates):goto "CalculateWestTemplateCosts"

_count = 0
_totalTemplates = Count eastTemplateNames

#CalculateEastTemplateCosts

	_cost = (eastPrimaryCosts Select (eastTemplatePrimary Select _count)) + (eastSecondaryCosts Select (eastTemplateSecondary Select _count)) + (eastSidearmCosts Select (eastTemplateSidearms Select _count))
	_cost = _cost + ((eastPrimaryAmmoCosts Select (eastTemplatePrimary Select _count)) * (eastTemplatePrimaryAmmo Select _count))
	_cost = _cost + ((eastSecondaryAmmoCosts Select (eastTemplateSecondary Select _count)) * (eastTemplateSecondaryAmmo Select _count))
	_cost = _cost + (((miscCosts Select (eastTemplateMisc Select _count)) * (eastTemplateAmount Select _count)) + ((miscCosts Select (eastTemplateMisc1 Select _count)) * (eastTemplateAmount1 Select _count)))

	eastTemplateCosts = eastTemplateCosts + [_cost]
	_count = _count + 1
	? (_count < _totalTemplates):goto "CalculateEastTemplateCosts"

